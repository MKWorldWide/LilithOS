# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 100
trim_trailing_whitespace = true

# Markdown files
[*.md]
trim_trailing_whitespace = false

# JSON files
[*.json]
indent_size = 2

# Python files
[*.py]
indent_size = 4

# YAML files
[*.{yaml,yml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Batch files
[*.bat]
end_of_line = crlf

# Makefiles use tabs for indentation
[Makefile]
indent_style = tab

# Dockerfiles use 4 spaces
[Dockerfile]
indent_size = 4

# Ignore package-lock.json
[package-lock.json]
indent_size = 0
